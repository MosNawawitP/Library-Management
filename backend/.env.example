ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5088

Jwt__Issuer=LibraryManagement.Api
Jwt__Audience=LibraryManagement.Client
Jwt__ExpirationHours=8
Jwt__SigningKey=replace-with-a-cryptographically-random-secret-of-at-least-32-bytes

Cors__AllowedOrigins__0=http://localhost:3000

Storage__Provider=JsonMock
Storage__DataDirectory=../../data
Storage__AuthFileName=user.json
Storage__UserSessionFileName=userSession.json
Storage__LibraryFileName=library.json
